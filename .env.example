# ProofHire 2.0 Environment Configuration Example
# Copy to .env (backend) and frontend/.env.local (frontend). NEVER commit actual secrets.

# Environment Mode: development | testing | staging | production
ENVIRONMENT="development"

# Application Settings
PROJECT_NAME="ProofHire 2.0"
VERSION="2.0.0"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS="http://localhost:3000"

# Database Connection (Dual SQLite / PostgreSQL)
# 1. Local SQLite (default zero-dependency demo):
DATABASE_URL="sqlite:///./proofhire.db"
# 2. Staging / Production PostgreSQL (Supabase):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# GitHub OAuth & Public API (Optional; public API + demo fallback used if omitted)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_TOKEN=""

# Optional LLM Provider (Deterministic fallback active if omitted)
OPENAI_API_KEY=""

# Optional SMTP Email Provider (Recorded as simulated_preview if omitted)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Frontend Public API URL (set in frontend/.env.local and Vercel)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Server Binding
HOST="0.0.0.0"
PORT=8000
